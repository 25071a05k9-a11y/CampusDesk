# CampusDesk v5: no login and no email OTP. College Wi-Fi gate only.
# Confirm the precise Windows SSID first using: netsh wlan show interfaces
# Set exact name once known; until then VNRVJIET_E prefix matching is used.
CAMPUSDESK_WIFI_SSID=
CAMPUSDESK_WIFI_SSID_PREFIXES=VNRVJIET_E
CAMPUSDESK_DATA=data/campusdesk.json

# Optional Jev routing API. No key -> clearly labeled local guided routing.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Optional external OpenAI-compatible AI chat completion endpoint.
# The assistant works in basic local guidance mode without credentials.
# Only enable record transmission with consent and permission.
AGENT_API_KEY=
AGENT_API_URL=
AGENT_MODEL=
AGENT_SEND_RECORDS=0

# Preferred AGY chat engine: official CLI, locally executed in --sandbox mode.
# Setup_AGY_Windows.cmd guides installation + interactive sign-in. No dangerous permission bypass.
AGY_CLI_ENABLED=1
AGY_CLI_BINARY=agy
AGY_CLI_TIMEOUT_SECONDS=70
AGY_CLI_SEND_RECORDS=0

# Alternative: optional Antigravity/Hermes AI bridge (reference: ypnpt6ysmw-bit/agy-cli).
# The bridge runs as a SEPARATE process. CampusDesk runs on port 8000;
# run the bridge on port 8765 to avoid collision.
AGY_BRIDGE_ENABLED=0
AGY_BRIDGE_URL=http://127.0.0.1:8765/v1/chat/completions
AGY_BRIDGE_MODEL=Gemini 3.5 Flash
AGY_BRIDGE_API_KEY=
AGY_BRIDGE_TIMEOUT_SECONDS=75
AGY_BRIDGE_SEND_RECORDS=0
AGY_BRIDGE_ALLOW_REMOTE=0
